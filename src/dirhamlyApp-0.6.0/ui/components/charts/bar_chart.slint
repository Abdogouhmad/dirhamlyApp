import { Theme } from "../../theme.slint";
import { ChartAxis, AxisLabel } from "chart_axis.slint";
import { Bar } from "chart_pattern.slint";

export struct ChartBarGroup {
    label: string,
    primary: float,
    secondary: float,
}

export component GroupedBarChart inherits Rectangle {
    in property <[ChartBarGroup]> bars: [];
    in property <float> max-value: 1.0;
    in property <color> primary-color: Theme.income;
    in property <color> secondary-color: Theme.expense;
    in property <length> bar-width: 14px;
    in property <length> bar-spacing: 3px;
    in property <length> label-height: 16px;
    in property <int> grid-lines: 4;
    in property <string> max-label: "";

    private property <length> bar-area-height: max(0px, root.height - root.label-height - 2px);

    clip: true;

    ChartAxis {
        width: 100%;
        height: 100%;
        grid-lines: root.grid-lines;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 2px;

        Rectangle {
            height: root.bar-area-height;

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: Theme.spacing-sm;
                padding-right: Theme.spacing-sm;
                spacing: Theme.spacing-sm;

                for group in root.bars :
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: root.bar-spacing;

                        Bar {
                            width: root.bar-width;
                            bar-height: max(2px, (group.primary / max(1.0, root.max-value)) * root.bar-area-height);
                            bar-color: root.primary-color;
                        }
                        Bar {
                            width: root.bar-width;
                            bar-height: max(2px, (group.secondary / max(1.0, root.max-value)) * root.bar-area-height);
                            bar-color: root.secondary-color;
                        }
                    }
            }
        }

        Rectangle {
            height: root.label-height;

            HorizontalLayout {
                width: 100%;
                padding-left: Theme.spacing-sm;
                padding-right: Theme.spacing-sm;
                spacing: Theme.spacing-sm;

                for group in root.bars :
                    AxisLabel {
                        text: group.label;
                        horizontal-stretch: 1;
                    }
            }
        }
    }

    if root.max-label != "" : AxisLabel {
        x: 2px;
        y: 1px;
        horizontal-alignment: left;
        text: root.max-label;
    }
}
