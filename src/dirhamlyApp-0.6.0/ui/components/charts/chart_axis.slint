import { Theme } from "../../theme.slint";
import { ChartPattern } from "chart_pattern.slint";

export component AxisLabel inherits Text {
    font-size: 11px;
    font-weight: Theme.font-weight-medium;
    color: Theme.text-muted;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component LegendItem inherits HorizontalLayout {
    in property <color> color;
    in property <string> label;

    spacing: Theme.spacing-xs;
    alignment: center;

    Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        background: root.color;
    }
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: 12px;
    }
}

export component ChartAxis inherits Rectangle {
    in property <int> grid-lines: 4;
    in property <length> line-width: 1px;
    in property <color> line-color: Theme.border;

    ChartPattern {
        width: 100%;
        height: 100%;
        count: root.grid-lines;
        line-width: root.line-width;
        line-color: root.line-color;
    }
}
