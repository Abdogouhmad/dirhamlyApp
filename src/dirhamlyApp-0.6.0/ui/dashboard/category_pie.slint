import { Theme } from "../theme.slint";

export struct CategoryItemData {
    category: string,
    amount: float,
    amount_str: string,
    percentage: float,
}

export component CategoryPie inherits Rectangle {
    in property <[CategoryItemData]> categories: [];
    in property <string> currency: "MAD";

    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: Theme.spacing-lg;
        spacing: Theme.spacing-md;

        Text {
            text: "Expenses by Category";
            color: Theme.text-primary;
            font-size: 16px;
            font-weight: Theme.font-weight-bold;
        }

        if categories.length == 0 : VerticalLayout {
            alignment: center;
            height: 200px;
            Text {
                text: "No expenses recorded yet.";
                color: Theme.text-muted;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }

        if categories.length > 0 : VerticalLayout {
            spacing: Theme.spacing-md;

            for cat in root.categories : VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 2px;
                            background: Theme.accent;
                        }

                        Text {
                            text: cat.category;
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: Theme.font-weight-medium;
                        }
                    }

                    Text {
                        text: cat.amount_str + " " + root.currency;
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }
                }

                Rectangle {
                    height: 8px;
                    background: Theme.surface-alt;
                    border-radius: 4px;

                    HorizontalLayout {
                        Rectangle {
                            width: max(2px, cat.percentage * parent.width);
                            height: 8px;
                            background: Theme.accent;
                            border-radius: 4px;
                        }
                    }
                }
            }
        }
    }
}
