export global Theme {
    // Backgrounds
    out property <color> background: #07090d;
    out property <color> surface: #121824;
    out property <color> surface-hover: #192234;
    out property <color> surface-alt: #161e2e;
    out property <color> surface-input: #0d131f;
    out property <color> border: #232d42;
    out property <color> border-light: #2e3b54;

    // Text Colors
    out property <color> text-primary: #f3f4f6;
    out property <color> text-secondary: #9ca3af;
    out property <color> text-muted: #6b7280;

    // Primary Colors
    out property <color> primary: #4f7cff;
    out property <color> on-primary: #f3f4f6;

    // colors of success, warning, and danger
    out property <color> success: #22c55e;
    out property <color> warning: #f59e0b;
    out property <color> danger: #ef4444;
    // Financial Accent Colors
    out property <color> income: #22c55e;
    out property <color> income-bg: #22c55e1c;
    out property <color> expense: #ef4444;
    out property <color> expense-bg: #ef44441c;
    out property <color> savings: #06b6d4;
    out property <color> savings-bg: #06b6d41c;
    out property <color> balance: #8b5cf6;
    out property <color> balance-bg: #8b5cf61c;

    // Brand Accent
    out property <color> accent: #4f7cff;
    out property <color> accent-hover: #3b68e5;

    // Typography
    out property <int> font-weight-normal: 400;
    out property <int> font-weight-medium: 500;
    out property <int> font-weight-semibold: 600;
    out property <int> font-weight-bold: 700;

    // Spacing
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> spacing-xl: 32px;

    // Radii
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 20px;
}
