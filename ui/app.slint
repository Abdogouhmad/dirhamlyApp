import { Theme } from "theme.slint";
import { Onboarding } from "onboarding.slint";
import { Dashboard } from "dashboard/dashboard.slint";
import { SettingsDialog } from "settings.slint";
import { MonthlyBalanceData } from "dashboard/monthly_chart.slint";
import { CategoryItemData } from "dashboard/category_pie.slint";
import { TransactionRowData } from "dashboard/table.slint";

export component AppWindow inherits Window {
    title: "Dirhamly — Finance OS";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.background;

    in-out property <int> active-page: 0; // 0: Onboarding, 1: Dashboard

    // Profile state
    in-out property <string> user-name: "";
    in-out property <string> currency: "MAD";
    in-out property <string> avatar-initials: "U";

    // Summary metrics
    in-out property <string> total-income: "0.00";
    in-out property <string> total-expense: "0.00";
    in-out property <string> net-savings: "0.00";
    in-out property <string> current-balance: "0.00";

    // Data models
    in-out property <[MonthlyBalanceData]> monthly-data: [];
    in-out property <float> monthly-max: 1000.0;
    in-out property <[CategoryItemData]> category-data: [];
    in-out property <[TransactionRowData]> transactions: [];

    // Settings
    in-out property <bool> show-settings: false;

    // Callbacks to Rust
    callback save-profile(string, string, string); // (name, image, currency)
    callback update-settings(string, string); // (name, currency)
    callback reset-profile();
    callback add-transaction(string, string, string, string, string); // (tx_type, amount, category, desc, date)
    callback delete-transaction(int); // id
    callback filter-transactions(string); // year-month filter

    // Main content with global padding
    VerticalLayout {
        padding: 12px;

        if active-page == 0 : Onboarding {
            submit-profile(name, img, curr) => {
                root.save-profile(name, img, curr);
            }
        }

        if active-page == 1 : Dashboard {
            user-name: root.user-name;
            currency: root.currency;
            total-income: root.total-income;
            total-expense: root.total-expense;
            net-savings: root.net-savings;
            current-balance: root.current-balance;
            monthly-data: root.monthly-data;
            monthly-max: root.monthly-max;
            category-data: root.category-data;
            transactions: root.transactions;
            avatar-initials: root.avatar-initials;

            open-settings => {
                root.show-settings = true;
            }

            submit-new-tx(t, a, c, d, dt) => {
                root.add-transaction(t, a, c, d, dt);
            }
            confirm-delete-tx(id) => {
                root.delete-transaction(id);
            }
            filter-month-changed(m) => {
                root.filter-transactions(m);
            }
        }
    }

    // Settings overlay
    if root.show-settings : SettingsDialog {
        user-name: root.user-name;
        currency: root.currency;
        avatar-initials: root.avatar-initials;

        save-settings(name, curr) => {
            root.update-settings(name, curr);
        }
        reset-profile => {
            root.reset-profile();
            root.show-settings = false;
        }
        close-settings => {
            root.show-settings = false;
        }
    }
}
