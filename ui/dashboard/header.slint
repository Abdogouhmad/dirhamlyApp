import { Theme } from "../theme.slint";
import { Button } from "std-widgets.slint";

export component DashHeader inherits Rectangle {
    in property <string> user-name: "User";
    in property <string> currency: "MAD";
    in property <string> avatar-initials: "U";
    in property <image> profile-image-data;
    callback open-add-tx();
    callback open-settings();

    height: 72px;
    background: transparent;

    HorizontalLayout {
        padding-left: Theme.spacing-lg;
        padding-right: Theme.spacing-lg;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: "Good day, " + root.user-name + " 👋";
                color: Theme.text-primary;
                font-size: 20px;
                font-weight: Theme.font-weight-bold;
            }

            Text {
                text: "Here's what's happening with your finances today.";
                color: Theme.text-secondary;
                font-size: 13px;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: Theme.spacing-md;

            Button {
                text: "+ Add Transaction";
                primary: true;
                height: 38px;
                clicked => { root.open-add-tx(); }
            }

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: root.profile-image-data.width > 0 ? transparent : Theme.accent;
                border-width: 2px;
                border-color: root.profile-image-data.width > 0 ? Theme.accent-hover : Theme.accent-hover;

                if root.profile-image-data.width > 0 : Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 20px;
                    clip: true;
                    Image {
                        source: root.profile-image-data;
                        width: 40px; height: 40px;
                    }
                }

                if !(root.profile-image-data.width > 0) : Text {
                    text: root.avatar-initials;
                    color: #ffffff;
                    font-size: 18px;
                    font-weight: Theme.font-weight-bold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.open-settings(); }
                }
            }
        }
    }
}
