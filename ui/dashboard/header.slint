import { Theme } from "../theme.slint";
import { Button } from "std-widgets.slint";

export component DashHeader inherits Rectangle {
    in property <string> user-name: "User";
    in property <string> currency: "MAD";
    in property <string> avatar-initials: "U";
    callback open-add-tx();
    callback open-settings();

    height: 72px;
    background: transparent;

    HorizontalLayout {
        padding-left: Theme.spacing-lg;
        padding-right: Theme.spacing-lg;
        alignment: space-between;

        // Left Side: Greeting & Subtitle
        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: "Good day, " + root.user-name + " 👋";
                color: Theme.text-primary;
                font-size: 20px;
                font-weight: Theme.font-weight-bold;
            }

            Text {
                text: "Here's what's happening with your finances today.";
                color: Theme.text-secondary;
                font-size: 13px;
            }
        }

        // Right Side: Add Tx Button + Avatar
        HorizontalLayout {
            alignment: center;
            spacing: Theme.spacing-md;

            // Add Transaction Button
            Button {
                text: "+ Add Transaction";
                primary: true;
                height: 38px;
                clicked => { root.open-add-tx(); }
            }

            // Avatar — clickable to open settings
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: Theme.accent;
                border-width: 2px;
                border-color: Theme.accent-hover;

                Text {
                    text: root.avatar-initials;
                    color: #ffffff;
                    font-size: 18px;
                    font-weight: Theme.font-weight-bold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.open-settings(); }
                }
            }
        }
    }
}
