import { Theme } from "../theme.slint";

export struct MonthlyBalanceData {
    month: string,
    income: float,
    expense: float,
}

export component MonthlyChart inherits Rectangle {
    in property <[MonthlyBalanceData]> months: [];
    in property <float> max-val: 1000.0;
    in property <string> currency: "MAD";

    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: Theme.spacing-lg;
        spacing: Theme.spacing-md;

        HorizontalLayout {
            alignment: space-between;

            Text {
                text: "Monthly Performance";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: Theme.font-weight-bold;
            }

            HorizontalLayout {
                spacing: Theme.spacing-md;

                HorizontalLayout {
                    spacing: Theme.spacing-xs;
                    alignment: center;

                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 3px;
                        background: Theme.income;
                    }
                    Text {
                        text: "Income";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.spacing-xs;
                    alignment: center;

                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 3px;
                        background: Theme.expense;
                    }
                    Text {
                        text: "Expense";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }
                }
            }
        }

        Rectangle {
            height: 180px;
            background: Theme.surface-alt;
            border-radius: Theme.radius-md;

            VerticalLayout {
                padding: Theme.spacing-md;

                // Y-axis reference lines + bars
                Rectangle {
                    horizontal-stretch: 1;
                    height: 140px;

                    // Horizontal grid lines
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle { height: 1px; background: Theme.border; }
                        Rectangle { height: 34px; }
                        Rectangle { height: 1px; background: Theme.border; }
                        Rectangle { height: 34px; }
                        Rectangle { height: 1px; background: Theme.border; }
                        Rectangle { height: 34px; }
                        Rectangle { height: 1px; background: Theme.border; }
                    }

                    // Bars
                    HorizontalLayout {
                padding-left: Theme.spacing-sm;
                        padding-right: Theme.spacing-sm;
                padding-top: Theme.spacing-xs;
                        spacing: 8px;

                        for item in root.months : VerticalLayout {
                            alignment: end;
                            spacing: 2px;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 3px;

                                Rectangle {
                                    width: 14px;
                                    height: max(2px, (item.income / max(1.0, root.max-val)) * 110px);
                                    background: Theme.income;
                                    border-radius: 4px;
                                    border-bottom-left-radius: 0px;
                                    border-bottom-right-radius: 0px;
                                }

                                Rectangle {
                                    width: 14px;
                                    height: max(2px, (item.expense / max(1.0, root.max-val)) * 110px);
                                    background: Theme.expense;
                                    border-radius: 4px;
                                    border-bottom-left-radius: 0px;
                                    border-bottom-right-radius: 0px;
                                }
                            }

                            Text {
                                text: item.month;
                                color: Theme.text-muted;
                                font-size: 10px;
                                horizontal-alignment: center;
                                height: 14px;
                            }
                        }
                    }
                }
            }
        }
    }
}
